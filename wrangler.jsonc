// Cloudflare Worker "qwader" (connected to this GitHub repo; every push to main redeploys).
// The build step compiles the React app; the Worker serves it and proxies /api/* to the backend.
{
  "$schema": "web/node_modules/wrangler/config-schema.json",
  "name": "qwader",
  "main": "web/worker/index.js",
  "compatibility_date": "2025-10-01",
  "build": {
    "command": "cd web && npm ci && npm run build:pages"
  },
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request runs the Worker first so plain-http visits are redirected to https.
    "run_worker_first": true
  },
  "vars": {
    // Switch to https:// once SSL is enabled for qwader.runasp.net on MonsterASP.
    "API_ORIGIN": "http://qwader.runasp.net"
  },
  "observability": {
    "enabled": true
  }
}
