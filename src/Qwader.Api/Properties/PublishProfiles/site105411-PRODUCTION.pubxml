<?xml version="1.0" encoding="utf-8"?>
<!--
  نسخة العميل (الإنتاج): https://qwader.premiumasp.net — قاعدة البيانات db78301.
  قبل النشر: ابنِ الواجهة (cd web && npm run build) لأن Visual Studio لا يبنيها.
  ملف الإعدادات المرفوع هو deploy/premium/appsettings.Production.json (وليس ملف المشروع الذي يخص نسخة التست).
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <Configuration>Release</Configuration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://qwader.premiumasp.net/</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <ExcludeApp_Data>true</ExcludeApp_Data>
    <ProjectGuid>dadff427-0dd7-4ba2-a3d0-251d9426a586</ProjectGuid>
    <MSDeployServiceURL>site105411.siteasp.net</MSDeployServiceURL>
    <DeployIisAppPath>site105411</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>true</EnableMSDeployBackup>
    <EnableMsDeployAppOffline>true</EnableMsDeployAppOffline>
    <UserName>site105411</UserName>
    <_SavePWD>true</_SavePWD>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PremiumSettings>$(MSBuildProjectDirectory)\..\..\deploy\premium\appsettings.Production.json</PremiumSettings>
  </PropertyGroup>

  <!-- The customer's site must never get the test settings: swap in its own file, and stop if it is missing. -->
  <Target Name="UsePremiumSettings" AfterTargets="ComputeResolvedFilesToPublishList">
    <Error Condition="!Exists('$(PremiumSettings)')" Text="ملف إعدادات الإنتاج غير موجود: $(PremiumSettings) — لا يمكن النشر لنسخة العميل بدونه." />
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'appsettings.Production.json'" />
      <ResolvedFileToPublish Include="$(PremiumSettings)" RelativePath="appsettings.Production.json" CopyToPublishDirectory="Always" />
    </ItemGroup>
  </Target>
</Project>
