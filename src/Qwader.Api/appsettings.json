{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "Qwader",
    "Audience": "Qwader.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/qwader-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 }
      }
    ]
  },
  "AllowedHosts": "*"
}
